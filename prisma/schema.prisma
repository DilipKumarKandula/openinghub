generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(uuid())
  title       String
  companyName String
  location    String

  experience  String
  jobType     String
  workMode    String

  applyUrl    String

  description String

  status      JobStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum JobStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}